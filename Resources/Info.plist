<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hides the app from the Dock. DialKit runs as a menu bar daemon only. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Required for Bluetooth HID access (IOKit will prompt on first open). -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>DialKit needs Bluetooth access to communicate with your Surface Dial.</string>

    <!-- Required if Input Monitoring entitlement is needed for HID access. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>DialKit uses Apple Events to send keyboard shortcuts on your behalf.</string>

    <key>CFBundleIdentifier</key>
    <string>com.dialkit.DialKit</string>

    <key>CFBundleName</key>
    <string>DialKit</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
</dict>
</plist>
